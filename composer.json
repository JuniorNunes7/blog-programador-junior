{
  "name": "juniornunes7/blog-programador-junior",
  "description": "Blog editorial em PHP orientado por arquivos Markdown.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "league/commonmark": "^2.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.12"
  },
  "autoload": {
    "psr-4": {
      "Blog\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "build:index": "php bin/build-index.php",
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 bin config src tests",
    "lint:fix": "phpcbf --standard=PSR12 bin config src tests"
  },
  "config": {
    "sort-packages": true
  }
}