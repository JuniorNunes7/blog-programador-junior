<?xml version="1.0"?>
<ruleset name="Programador Junior">
    <description>Aplica PSR-12 a todos os arquivos PHP do projeto.</description>

    <arg name="colors"/>
    <arg name="report" value="full"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength.TooLong">
        <severity>0</severity>
    </rule>
    <rule ref="Internal.NoCodeFound">
        <severity>0</severity>
    </rule>

    <file>bin</file>
    <file>config</file>
    <file>src</file>
    <file>templates</file>
    <file>tests</file>
</ruleset>
